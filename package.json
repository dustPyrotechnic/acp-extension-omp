{
  "name": "acp-extension-omp",
  "version": "0.0.0",
  "description": "Lody-owned ACP adapter for Oh My Pi",
  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "omp-acp": "dist/index.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dustPyrotechnic/acp-extension-omp.git"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "contract:real": "node scripts/contract-real.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm exec prettier --check .",
    "prepack": "pnpm build",
    "pack": "pnpm pack"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.3.0",
    "acp-extension-core": "0.1.8",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
